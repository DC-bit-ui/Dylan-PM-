# HubSpot Private App token (required)
# Create at: Settings > Integrations > Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.deals.read,
#                  tickets (for HORIZON Snapshot ticket pipeline detection)
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Anthropic API key (required for AI analysis features)
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# Server port (optional, defaults to 3000)
PORT=3000

# Shared-growth-memory bus location. SharePoint-synced folder that the
# dashboard publishes to and Growth team members' Claude Code workspaces
# read from. Default falls back to C:\Dylan PM\shared-growth-memory if unset.
BUS_PATH=C:\Users\YOUR-USER\AgriProve\AgriProve - Documents\SHARED AP\Projects\Other Projects\Claude Code Projects\shared-growth-memory

# Daily scheduler — fires the full diagnosis pipeline once per day.
# Default is OFF; flip to true to enable. Hour is server-local 0-23.
SCHEDULE_ENABLED=true
SCHEDULE_DAILY_HOUR=5
SCHEDULE_DAILY_MINUTE=0

# Bus writes — controls whether the scheduler publishes rep queues + team-pulse
# to the SharePoint bus. Inert without consumers (Claude Code skill installs),
# so safe to enable before team is fully onboarded. Manual /api/bus/rebuild
# endpoint works regardless of this flag.
BUS_WRITES_ENABLED=true

# Microsoft Graph integration for Operation Storm Boy Teams channel scanning
# (snapshot-state's third evidence channel). Optional — leave unset to skip
# Teams detection. Requires Azure AD app registration with Application
# permissions: ChannelMessage.Read.All, Team.ReadBasic.All, Channel.ReadBasic.All
# + admin consent. See shared-growth-memory/skills/README.md for setup details.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TEAM_NAME=Operation Storm Boy
# MS_GRAPH_CHANNEL_NAME=Deals
